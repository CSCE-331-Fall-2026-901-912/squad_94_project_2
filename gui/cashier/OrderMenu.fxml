                  <Label fx:id="selected_drink_label" text="No drink selected" wrapText="true" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="400.0" prefWidth="208.0">
