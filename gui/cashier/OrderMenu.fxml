                    </rowConstraints>
                     <children>
                        <Button fx:id="no_ice_button" onAction = "#ice_selected" mnemonicParsing="false" prefHeight="180.0" prefWidth="160.0" text="None" />
                        <Button fx:id="light_ice_button" onAction = "#ice_selected" mnemonicParsing="false" prefHeight="180.0" prefWidth="160.0" text="Light" GridPane.columnIndex="1" />
                        <Button fx:id="regular_ice_button" onAction = "#ice_selected" mnemonicParsing="false" prefHeight="180.0" prefWidth="160.0" text="Regular" GridPane.rowIndex="1" />
